{% comment %}
  MARÉ — barra de progresso escalonada
  Comunica os degraus. NÃO adiciona brinde nem aplica desconto: isso é trabalho
  de Discount Function, que roda no servidor e vale também no checkout.
  Todo cálculo em Liquid, no servidor. O JS só troca este HTML pelo que o
  servidor devolveu via o parâmetro `sections=` da Cart AJAX API.
{% endcomment %}

{% liquid
  assign total = cart.total_price
  assign d1 = section.settings.degrau_1
  assign d2 = section.settings.degrau_2
  assign d3 = section.settings.degrau_3

  assign teto = d3
  if d3 == 0
    assign teto = d2
  endif
  if teto == 0
    assign teto = d1
  endif

  assign pct = 0
  if teto > 0
    assign pct = total | times: 100 | divided_by: teto
    if pct > 100
      assign pct = 100
    endif
  endif
%}

<div class="mare-barra mare-section" role="status" aria-live="polite">
  <div class="mare-barra__trilho">
    <div class="mare-barra__fill" style="--mare-pct: {{ pct }}%"></div>

    {%- if d1 > 0 and teto > 0 -%}
      <span class="mare-barra__marca {% if total >= d1 %}is-ok{% endif %}"
            style="--mare-x: {{ d1 | times: 100 | divided_by: teto }}%"></span>
    {%- endif -%}
    {%- if d2 > 0 and teto > 0 -%}
      <span class="mare-barra__marca {% if total >= d2 %}is-ok{% endif %}"
            style="--mare-x: {{ d2 | times: 100 | divided_by: teto }}%"></span>
    {%- endif -%}
  </div>

  <p class="mare-barra__texto">
    {%- if d1 > 0 and total < d1 -%}
      Faltam <b>{{ d1 | minus: total | money }}</b> para {{ section.settings.premio_1 | escape }}
    {%- elsif d2 > 0 and total < d2 -%}
      {{ section.settings.premio_1 | escape }} liberado. Faltam
      <b>{{ d2 | minus: total | money }}</b> para {{ section.settings.premio_2 | escape }}
    {%- elsif d3 > 0 and total < d3 -%}
      {{ section.settings.premio_2 | escape }} liberado. Faltam
      <b>{{ d3 | minus: total | money }}</b> para {{ section.settings.premio_3 | escape }}
    {%- else -%}
      {{ section.settings.texto_completo | escape }}
    {%- endif -%}
  </p>
</div>

{% stylesheet %}
  .mare-barra { padding: 1rem 1.25rem; background: transparent; }

  .mare-barra__trilho {
    position: relative; height: 8px; border-radius: 999px;
    background: color-mix(in srgb, var(--mare-ameixa) 12%, transparent);
    overflow: visible;
  }

  .mare-barra__fill {
    height: 100%; width: var(--mare-pct, 0%); border-radius: 999px;
    background: linear-gradient(90deg, var(--mare-sol), var(--mare-tangerina) 55%, var(--mare-coral));
    transition: width .3s ease;
  }

  .mare-barra__marca {
    position: absolute; top: 50%; left: var(--mare-x, 0%);
    width: 10px; height: 10px; margin: -5px 0 0 -5px;
    border-radius: 50%; background: var(--mare-areia);
    border: 2px solid color-mix(in srgb, var(--mare-ameixa) 30%, transparent);
  }
  .mare-barra__marca.is-ok { background: var(--mare-pitaya); border-color: var(--mare-pitaya); }

  .mare-barra__texto {
    margin: .625rem 0 0; font-family: var(--mare-corpo);
    font-size: var(--mare-t-micro); color: var(--mare-ameixa);
  }
  .mare-barra__texto b { color: var(--mare-pitaya); }

  @media (prefers-reduced-motion: reduce) { .mare-barra__fill { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Barra de frete",
  "settings": [
    { "type": "paragraph", "content": "Valores em centavos. R$ 199,00 = 19900. Deixe 0 para desativar um degrau." },
    { "type": "number", "id": "degrau_1", "label": "Degrau 1 — valor", "default": 19900 },
    { "type": "text", "id": "premio_1", "label": "Degrau 1 — prêmio", "default": "frete grátis" },
    { "type": "number", "id": "degrau_2", "label": "Degrau 2 — valor", "default": 29900 },
    { "type": "text", "id": "premio_2", "label": "Degrau 2 — prêmio", "default": "o mixer MARÉ" },
    { "type": "number", "id": "degrau_3", "label": "Degrau 3 — valor", "default": 0 },
    { "type": "text", "id": "premio_3", "label": "Degrau 3 — prêmio" },
    { "type": "text", "id": "texto_completo", "label": "Texto quando tudo liberado", "default": "Tudo liberado. Sua maré está cheia." }
  ]
}
{% endschema %}
