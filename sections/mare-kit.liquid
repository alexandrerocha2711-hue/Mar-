{% comment %}
  MARÉ — monte sua caixa
  ---------------------------------------------------------------------------
  O cliente escolhe QUANTAS marés e QUAIS sabores, um a um. Pode ser um de
  cada, dois de um e um de outro, três iguais — qualquer combinação.

  POR QUE ISTO NÃO PRECISA DE APP
  O desconto NÃO é calculado aqui. Ele é um desconto automático da Shopify
  ("3 ou mais unidades da coleção Sabores → 10%"), aplicado no carrinho pela
  própria plataforma. Como a regra é por QUANTIDADE, qualquer mistura de
  sabores já conta: 3 melancias e 2+1 dão exatamente no mesmo lugar.
  Esta seção é só a vitrine dessa regra — ela mostra, não decide.

  POR ISSO OS DEGRAUS PRECISAM ESPELHAR O ADMIN.
  O campo "Degraus" existe para exibir o preço antes do carrinho. Se você
  mudar o desconto no admin e não mudar aqui, a tela promete um preço que o
  carrinho não cumpre — o que é infração ao art. 30 do CDC, não bug visual.
  Mude nos dois lugares, sempre.

  FUNCIONA SEM JAVASCRIPT
  Os campos de quantidade são inputs de verdade, com nome `items[N][quantity]`,
  dentro de um <form> que aponta para /cart/add. Sem JS, o cliente digita as
  quantidades e o envio normal do formulário adiciona tudo e cai no carrinho.
  Com JS, ganha os botões de + e −, o total ao vivo e a adição sem recarregar.
{% endcomment %}

{%- liquid
  assign p = section.settings.produto
  assign meta_frete = shop.metafields.mare.frete_gratis.value | default: 20000
  assign degraus = section.settings.degraus | split: ','
  assign cores = section.settings.cores | split: ','
-%}

{%- if p != blank and p.variants.size > 0 -%}
  <section class="mare-kit mare-section" aria-labelledby="mare-kit-{{ section.id }}">
    <div class="mare-wrap mare-wrap--estreito">

      <header class="mare-kit__head mare-revela">
        {%- if section.settings.olho != blank -%}
          <p class="mare-olho">{{ section.settings.olho | escape }}</p>
        {%- endif -%}
        <h2 class="mare-h mare-kit__titulo" id="mare-kit-{{ section.id }}">
          {{ section.settings.titulo | escape }}
        </h2>
        {%- if section.settings.linha_fina != blank -%}
          <p class="mare-kit__fina">{{ section.settings.linha_fina | escape }}</p>
        {%- endif -%}
      </header>

      <form
        class="mare-kit__form"
        action="{{ routes.cart_add_url }}"
        method="post"
        enctype="multipart/form-data"
        data-mare-kit
        data-mare-frete="{{ meta_frete }}"
        data-mare-degraus="{{ section.settings.degraus | escape }}"
        data-mare-moeda="{{ shop.currency }}"
      >
        {%- if degraus.size > 0 -%}
          <div class="mare-kit__degraus" role="group" aria-label="{{ section.settings.rotulo_degraus | escape }}">
            {%- for degrau in degraus -%}
              {%- liquid
                assign partes = degrau | strip | split: ':'
                assign qtd = partes[0] | plus: 0
                assign pct = partes[1] | plus: 0
              -%}
              <button type="button" class="mare-kit__degrau" data-mare-degrau="{{ qtd }}">
                <span class="mare-kit__degrau-qtd">{{ qtd }} marés</span>
                <span class="mare-kit__degrau-pct">−{{ pct }}%</span>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <ul class="mare-kit__sabores" role="list">
          {%- for v in p.variants -%}
            {%- liquid
              assign i = forloop.index0
              assign j = i | modulo: cores.size
              assign cor = v.metafields.mare.cor.value | default: cores[j] | strip
              assign descritor = v.metafields.mare.descritor.value
              assign foto = v.image | default: p.featured_image
            -%}
            <li class="mare-sabor" style="--mare-cor-sku: {{ cor }};">
              <input type="hidden" name="items[{{ i }}][id]" value="{{ v.id }}">

              <span class="mare-sabor__bolha" aria-hidden="true">
                {%- if foto -%}
                  {{ foto | image_url: width: 200 | image_tag: loading: 'lazy', class: 'mare-sabor__img', alt: '' }}
                {%- endif -%}
              </span>

              <span class="mare-sabor__texto">
                <label class="mare-sabor__nome" for="mare-qtd-{{ section.id }}-{{ i }}">
                  {{ v.title | escape }}
                </label>
                {%- if descritor != blank -%}
                  <span class="mare-sabor__descritor">{{ descritor | escape }}</span>
                {%- endif -%}
                {%- unless v.available -%}
                  <span class="mare-sabor__esgotado">{{ section.settings.rotulo_esgotado | escape }}</span>
                {%- endunless -%}
              </span>

              <span class="mare-sabor__contador">
                <button type="button" class="mare-sabor__passo" data-mare-menos aria-label="Tirar uma {{ v.title | escape }}">−</button>
                <input
                  id="mare-qtd-{{ section.id }}-{{ i }}"
                  class="mare-sabor__qtd"
                  type="number"
                  name="items[{{ i }}][quantity]"
                  value="0"
                  min="0"
                  max="{{ section.settings.max_por_sabor }}"
                  step="1"
                  inputmode="numeric"
                  data-mare-qtd
                  data-mare-preco="{{ v.price }}"
                  {% unless v.available %}disabled{% endunless %}
                >
                <button type="button" class="mare-sabor__passo" data-mare-mais aria-label="Somar uma {{ v.title | escape }}">+</button>
              </span>
            </li>
          {%- endfor -%}
        </ul>

        <div class="mare-kit__resumo" data-mare-resumo aria-live="polite">
          <p class="mare-kit__linha">
            <span data-mare-contagem>0 marés</span>
            <strong data-mare-total>—</strong>
          </p>
          <p class="mare-kit__nota" data-mare-nota>{{ section.settings.nota_inicial | escape }}</p>
        </div>

        <button type="submit" class="mare-btn mare-btn--sku mare-kit__cta" data-mare-enviar disabled>
          {{ section.settings.rotulo_cta | escape }}
        </button>

        <p class="mare-kit__aviso">{{ section.settings.aviso | escape }}</p>
      </form>
    </div>

    <script>
      (function () {
        var form = document.currentScript.parentNode.querySelector('[data-mare-kit]');
        if (!form || form.dataset.mareLigado) return;
        form.dataset.mareLigado = '1';
        form.classList.add('is-js');

        var campos = [].slice.call(form.querySelectorAll('[data-mare-qtd]'));
        var enviar = form.querySelector('[data-mare-enviar]');
        var elContagem = form.querySelector('[data-mare-contagem]');
        var elTotal = form.querySelector('[data-mare-total]');
        var elNota = form.querySelector('[data-mare-nota]');
        var metaFrete = parseInt(form.dataset.mareFrete, 10) || 0;

        var degraus = (form.dataset.mareDegraus || '').split(',').map(function (d) {
          var p = d.trim().split(':');
          return { qtd: parseInt(p[0], 10), pct: parseFloat(p[1]) || 0 };
        }).filter(function (d) { return d.qtd > 0; }).sort(function (a, b) { return a.qtd - b.qtd; });

        var moeda = new Intl.NumberFormat('pt-BR', {
          style: 'currency', currency: form.dataset.mareMoeda || 'BRL'
        });
        function preco(centavos) { return moeda.format(centavos / 100); }

        // O maior degrau alcançado manda. É a mesma regra da Shopify:
        // entre descontos automáticos elegíveis, vence o de maior valor.
        function degrauDe(total) {
          var achado = null;
          degraus.forEach(function (d) { if (total >= d.qtd) achado = d; });
          return achado;
        }

        function recalcular() {
          var unidades = 0, bruto = 0;

          campos.forEach(function (campo) {
            var q = parseInt(campo.value, 10);
            if (isNaN(q) || q < 0) q = 0;
            unidades += q;
            bruto += q * (parseInt(campo.dataset.marePreco, 10) || 0);
          });

          var d = degrauDe(unidades);
          var liquido = d ? Math.round(bruto * (1 - d.pct / 100)) : bruto;

          elContagem.textContent = unidades === 1 ? '1 maré' : unidades + ' marés';
          elTotal.textContent = unidades ? preco(liquido) : '—';
          enviar.disabled = unidades === 0;

          form.querySelectorAll('[data-mare-degrau]').forEach(function (btn) {
            btn.classList.toggle('is-ativo', !!d && parseInt(btn.dataset.mareDegrau, 10) === d.qtd);
          });

          if (!unidades) { elNota.textContent = elNota.dataset.inicial; return; }

          var partes = [];
          if (d) partes.push('−' + d.pct + '% já aplicado (' + preco(bruto - liquido) + ' de economia)');

          var proximo = degraus.filter(function (x) { return x.qtd > unidades; })[0];
          if (proximo) {
            var faltam = proximo.qtd - unidades;
            partes.push('faltam ' + faltam + (faltam === 1 ? ' unidade' : ' unidades') + ' para −' + proximo.pct + '%');
          }
          if (metaFrete && liquido >= metaFrete) partes.push('frete grátis');
          else if (metaFrete) partes.push('faltam ' + preco(metaFrete - liquido) + ' para o frete grátis');

          elNota.textContent = partes.join(' · ');
        }

        elNota.dataset.inicial = elNota.textContent;

        form.addEventListener('click', function (ev) {
          var btn = ev.target.closest('[data-mare-mais], [data-mare-menos], [data-mare-degrau]');
          if (!btn) return;
          ev.preventDefault();

          if (btn.hasAttribute('data-mare-degrau')) {
            // Distribui o degrau entre os sabores disponíveis, um por vez.
            // Ponto de partida sugerido — o cliente ajusta depois.
            var alvo = parseInt(btn.dataset.mareDegrau, 10);
            var livres = campos.filter(function (c) { return !c.disabled; });
            if (!livres.length) return;
            livres.forEach(function (c) { c.value = 0; });
            for (var n = 0; n < alvo; n++) {
              var c = livres[n % livres.length];
              c.value = parseInt(c.value, 10) + 1;
            }
          } else {
            var campo = btn.parentNode.querySelector('[data-mare-qtd]');
            if (!campo || campo.disabled) return;
            var max = parseInt(campo.max, 10) || 99;
            var atual = parseInt(campo.value, 10) || 0;
            campo.value = Math.min(max, Math.max(0, atual + (btn.hasAttribute('data-mare-mais') ? 1 : -1)));
          }
          recalcular();
        });

        form.addEventListener('input', function (ev) {
          if (ev.target.hasAttribute('data-mare-qtd')) recalcular();
        });

        form.addEventListener('submit', function (ev) {
          var itens = [];
          campos.forEach(function (campo) {
            var q = parseInt(campo.value, 10) || 0;
            if (q <= 0) return;
            var id = campo.closest('.mare-sabor').querySelector('input[type="hidden"]').value;
            itens.push({ id: Number(id), quantity: q });
          });
          if (!itens.length) { ev.preventDefault(); return; }

          // Sem fetch disponível, deixa o <form> enviar sozinho.
          if (!window.fetch) return;
          ev.preventDefault();

          var rotulo = enviar.textContent;
          enviar.disabled = true;
          enviar.textContent = 'Adicionando…';

          var raiz = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

          fetch(raiz + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ items: itens, sections: 'mare-barra-frete', sections_url: window.location.pathname })
          })
            .then(function (r) { return r.json().then(function (d) { if (!r.ok) throw new Error(d.description || 'erro'); return d; }); })
            .then(function (dados) {
              enviar.textContent = 'Na sacola';
              document.dispatchEvent(new CustomEvent('mare:carrinho:atualizado', { detail: dados }));
              window.setTimeout(function () { enviar.textContent = rotulo; enviar.disabled = false; }, 1600);
            })
            .catch(function (erro) {
              enviar.textContent = rotulo;
              enviar.disabled = false;
              console.error('[MARÉ] kit', erro);
            });
        });

        recalcular();
      })();
    </script>
  </section>
{%- endif -%}

{% stylesheet %}
  .mare-kit { padding-block: var(--mare-grid); }

  .mare-kit__head { margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
  .mare-kit__titulo { font-size: var(--mare-t-titulo); }
  .mare-kit__fina { margin: .875rem 0 0; opacity: .78; max-width: 48ch; }

  .mare-kit__form {
    display: grid; gap: 1.25rem;
    background: var(--mare-branco);
    border-radius: var(--mare-raio);
    padding: clamp(1.125rem, 3vw, 2rem);
    box-shadow: var(--mare-sombra-2);
  }

  .mare-kit__degraus { display: flex; flex-wrap: wrap; gap: .5rem; }
  .mare-kit__degrau {
    display: inline-grid; gap: .0625rem; justify-items: start;
    min-height: 48px; padding: .375rem 1rem;
    border: 0; border-radius: 999px; cursor: pointer;
    font-family: var(--mare-corpo); text-align: left;
    background: color-mix(in srgb, var(--mare-sol) 26%, transparent);
    color: var(--mare-ameixa);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--mare-sol) 60%, transparent);
    transition: transform .16s ease, background .16s ease;
  }
  .mare-kit__degrau:hover { transform: translateY(-1px); }
  .mare-kit__degrau.is-ativo { background: var(--mare-ameixa); color: var(--mare-sol); box-shadow: none; }
  .mare-kit__degrau-qtd { font-weight: 600; font-size: .9375rem; }
  .mare-kit__degrau-pct { font-size: var(--mare-t-micro); opacity: .75; }

  .mare-kit__sabores { list-style: none; margin: 0; padding: 0; display: grid; gap: .625rem; }

  .mare-sabor {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center; gap: .875rem;
    padding: .625rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--mare-cor-sku) 8%, transparent);
  }

  .mare-sabor__bolha {
    width: 52px; height: 52px; border-radius: 50%; overflow: hidden;
    display: grid; place-items: center;
    background: color-mix(in srgb, var(--mare-cor-sku) 26%, var(--mare-areia));
  }
  .mare-sabor__img { width: 100%; height: 100%; object-fit: contain; display: block; }

  .mare-sabor__texto { display: grid; gap: .0625rem; min-width: 0; }
  .mare-sabor__nome { font-weight: 600; font-size: 1rem; cursor: pointer; }
  .mare-sabor__descritor { font-size: var(--mare-t-micro); opacity: .66; }
  .mare-sabor__esgotado {
    font-size: .6875rem; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--mare-pitaya);
  }

  .mare-sabor__contador {
    display: inline-flex; align-items: center; gap: .125rem;
    background: var(--mare-branco); border-radius: 999px; padding: .1875rem;
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--mare-ameixa) 12%, transparent);
  }
  .mare-sabor__passo {
    width: 40px; height: 40px; border: 0; border-radius: 50%;
    background: transparent; cursor: pointer;
    font-size: 1.25rem; line-height: 1; color: var(--mare-ameixa);
  }
  .mare-sabor__passo:hover { background: color-mix(in srgb, var(--mare-cor-sku) 18%, transparent); }
  .mare-sabor__qtd {
    width: 3ch; height: 40px; border: 0; background: transparent;
    text-align: center; font: inherit; font-weight: 700;
    color: var(--mare-ameixa); -moz-appearance: textfield;
  }
  .mare-sabor__qtd::-webkit-outer-spin-button,
  .mare-sabor__qtd::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  /* Sem JS os botões de passo não fazem nada — some com eles e deixa o campo. */
  .mare-kit__form:not(.is-js) .mare-sabor__passo,
  .mare-kit__form:not(.is-js) .mare-kit__degraus,
  .mare-kit__form:not(.is-js) .mare-kit__resumo { display: none; }
  .mare-kit__form:not(.is-js) .mare-sabor__qtd {
    width: 4.5ch;
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--mare-ameixa) 14%, transparent);
    border-radius: 999px;
  }

  .mare-kit__resumo { display: grid; gap: .25rem; padding-top: .5rem; }
  .mare-kit__linha {
    margin: 0; display: flex; justify-content: space-between;
    align-items: baseline; gap: 1rem;
    font-family: var(--mare-display); font-size: 1.375rem; font-weight: 600;
  }
  .mare-kit__nota { margin: 0; font-size: var(--mare-t-micro); color: var(--mare-pitaya); font-weight: 600; }

  .mare-kit__cta { width: 100%; }
  .mare-kit__aviso { margin: 0; font-size: var(--mare-t-micro); opacity: .55; text-align: center; }

  @media (max-width: 520px) {
    .mare-sabor { grid-template-columns: auto 1fr; row-gap: .5rem; border-radius: var(--mare-raio); }
    .mare-sabor__contador { grid-column: 1 / -1; justify-self: stretch; justify-content: space-between; }
  }

  @media (prefers-reduced-motion: reduce) { .mare-kit__degrau { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Monte sua caixa",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "produto", "label": "Produto" },
    { "type": "text", "id": "olho", "label": "Sobretítulo", "default": "Monte sua caixa" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Leve mais de uma maré." },
    { "type": "text", "id": "linha_fina", "label": "Linha de apoio", "default": "Escolha quantas e quais. Pode ser uma de cada, ou três iguais — o desconto é por quantidade, não por sabor." },
    { "type": "header", "content": "Degraus de desconto" },
    { "type": "paragraph", "content": "Formato quantidade:porcentagem, separados por vírgula. ESTES VALORES SÓ EXIBEM O PREÇO — quem aplica o desconto é o desconto automático da Shopify. Se mudar lá, mude aqui também, ou a tela promete um preço que o carrinho não cumpre." },
    { "type": "text", "id": "degraus", "label": "Degraus", "default": "3:10,5:15" },
    { "type": "text", "id": "rotulo_degraus", "label": "Rótulo do grupo de degraus", "default": "Atalhos de quantidade" },
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "nota_inicial", "label": "Nota inicial", "default": "Some 3 marés e o desconto entra sozinho." },
    { "type": "text", "id": "rotulo_cta", "label": "Texto do botão", "default": "Adicionar à sacola" },
    { "type": "text", "id": "rotulo_esgotado", "label": "Texto quando esgotado", "default": "esgotado" },
    { "type": "text", "id": "aviso", "label": "Aviso", "default": "O desconto aparece no carrinho, aplicado automaticamente." },
    { "type": "header", "content": "Limites" },
    { "type": "range", "id": "max_por_sabor", "label": "Máximo por sabor", "min": 1, "max": 20, "step": 1, "default": 10 },
    { "type": "text", "id": "cores", "label": "Cores de reserva", "default": "#FF5436,#FF9500,#E8156B,#FFC943" }
  ],
  "presets": [{ "name": "Monte sua caixa" }]
}
{% endschema %}
